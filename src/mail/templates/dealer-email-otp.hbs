<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Verify your new DWMS email</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 520px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
      }
      .title {
        font-size: 22px;
        font-weight: bold;
        color: #0b214a;
        margin-bottom: 12px;
      }
      .message {
        font-size: 15px;
        color: #444;
        line-height: 1.5;
        margin-bottom: 24px;
      }
      .otp {
        display: inline-block;
        font-size: 32px;
        letter-spacing: 8px;
        font-weight: bold;
        color: #007b83;
        background: #f3fafb;
        border: 1px solid #cce7ea;
        border-radius: 8px;
        padding: 16px 24px;
        margin-bottom: 24px;
      }
      .expiry {
        font-size: 14px;
        color: #777;
      }
      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #aaa;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='title'>Verify your new email address</div>
      <div class='message'>
        Use this verification code to confirm your dealer email change in DWMS.
      </div>
      <div class='otp'>{{otp}}</div>
      <div class='expiry'>
        This code expires in
        <strong>{{expiresInMinutes}} minutes</strong>. If you did not request
        this change, you can ignore this email.
      </div>
      <div class='footer'>The DWMS Team</div>
    </div>
  </body>
</html>
