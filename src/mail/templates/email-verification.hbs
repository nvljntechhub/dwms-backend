<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Email Verification</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        margin: 0;
        padding: 0;
      }
      table {
        border-collapse: collapse;
      }

      .details-table {
        width: 100%;
        border-collapse: collapse;
      }

      .details-table td {
        padding: 12px 16px;
        font-size: 14px;
        vertical-align: top;
      }

      .details-table td p {
        width: 100%;
        text-align: left;
      }

      .details-table tr td {
        border-bottom: 1px solid #eee;
      }

      .first-col {
        width: 40%;

        text-align: left;
      }
      .second-col {
        width: 60%;

        text-align: right;
      }

      .card {
        width: 100%;
        margin: auto;
        background: #f2f1f033;
        border-radius: 12px;

        overflow: hidden;
      }

      .card-header {
        text-align: center;
        font-size: 17px;
        font-weight: bold;
        padding: 15px;
        border-bottom: 1px solid #eee;
        color: #007b83;
      }
      .title {
        font-size: 24px;
        font-weight: bold;
        color: #007b83;
        margin-bottom: 10px;
        margin-top: 20px;
      }
      .subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 20px;
        text-align: center;
      }
      .subtitle span {
        display: block;
      }
      .divider {
        border-top: 1.5px solid #027b96;
        margin: 20px 0;
      }
      .message {
        font-size: 15px;
        color: #444;
        margin-bottom: 25px;
        margin-top: 25px;
      }
      .verify-button {
        display: inline-block;
        padding: 14px 28px;
        border-radius: 8px;
        background-color: #0b214a;
        color: white !important;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
      }
      .expiry-message {
        margin-top: 30px;
        font-size: 14px;
        color: #777;
      }
      .info {
        margin-top: 15px;
        font-size: 14px;
        color: #777;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        color: #aaa;
        text-align: center;
      }
      .footer span {
        display: block;
      }
    </style>
  </head>
  <body>
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color: #f5f5f5'
    >
      <tr>
        <td align='center' style='padding: 80px 20px'>
          <table
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width: 650px; width: 100%; border-radius: none'
          >
            <tr>
              <td>
                <table
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='max-width: 650px; width: 100%'
                >
                  <tr>
                    <td style='vertical-align: bottom'>
                      <div
                        style='
                          background-color: #ffffff;
                          height: 60px;
                          border-radius: 30px 0 0 0;
                        '
                      ></div>
                    </td>
                    <td style='width: 120px'>
                      <div
                        style='
                          background-color: #ffffff;
                          width: 120px;
                          height: 120px;
                          padding: 10px;
                          border-radius: 50% 50% 0 0;
                        '
                      >
                        {{! <img
                          src='https://picsum.photos/seed/piccsum/200/300'
                          alt=' '
                          width='100%'
                          height='100%'
                          style='border-radius: 50%; display: block'
                        /> }}
                      </div>
                    </td>
                    <td style='vertical-align: bottom'>
                      <div
                        style='
                          background-color: #ffffff;
                          height: 60px;
                          border-radius: 0 30px 0 0;
                        '
                      ></div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td
                style='
                  width: 97px;
                  height: 48px;
                  border-radius: 0 0 30px 30px;
                  overflow: hidden;
                  position: relative;
                '
              >
                <table
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='width: 100%'
                >
                  <tr>
                    <td
                      width='20'
                      rowspan='1'
                      valign='middle'
                      style='height: 350px; background-color: #ffffff'
                    >
                      <div
                        style='
                          width: 11px;
                          height: 250px;
                          background-color: #007b83;
                          border-radius: 0 10px 10px 0;
                          margin: 0 auto;
                        '
                      ></div>
                    </td>

                    <td
                      style='
                        background-color: #ffffff;
                        text-align: center;
                        padding: 0px 30px 30px 30px;
                        position: relative;
                      '
                    >
                      <div class='title'>Welcome to Zenoff!</div>
                      <div class='subtitle'>
                        You're just one step away from getting started.
                      </div>
                      <div class='divider'></div>

                      <div class='message'>
                        Please confirm your email address to activate your
                        account.
                      </div>

                      <table
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        align='center'
                        style='margin-top: 30px'
                      >
                        <tr>
                          <td
                            style='
                              background-color: #0b214a;
                              border-radius: 8px;
                            '
                          >
                            <a
                              href='{{verificationLink}}'
                              style='
                                display: inline-block;
                                padding: 14px 28px;
                                color: white;
                                font-size: 16px;
                                font-weight: bold;
                                text-decoration: none;
                                font-family: Arial, sans-serif;
                              '
                            >Verify Email</a>
                          </td>
                        </tr>
                      </table>

                      <div class='expiry-message'>
                        For your security, this link will expire in
                        <strong>15 minutes</strong>. If it does, you can always
                        request a new one.
                      </div>
                      <div class='info'>
                        If you did not create an account with Zenoff. Please
                        ignore this email.
                      </div>
                      <div class='footer'>
                        <span>Thanks,</span>
                        <span>The Zenoff Team</span>
                      </div>
                    </td>

                    <td
                      width='20'
                      rowspan='1'
                      valign='middle'
                      style='height: 350px; background-color: #ffffff'
                    >
                      <div
                        style='
                          width: 11px;
                          height: 250px;
                          background-color: #007b83;
                          border-radius: 10px 0 0 10px;
                          margin: 0 auto;
                        '
                      ></div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>